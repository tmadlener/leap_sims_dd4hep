# Geant4 visualisation macro for the LEAP geometry.
#
#   QT_QPA_PLATFORM=xcb ddsim --compactFile compact/LEAP_calorimeter.xml \
#       --runType qt --macroFile vis.mac
#
# Note `--runType qt` and *not* `--runType vis`: every interactive viewer of
# this Geant4 build is Qt based (`OGL` is an alias for `TSG_QT_GLES` here), and
# `--runType vis` starts a plain tcsh session, in which those viewers cannot be
# created ("... is not compatible with the session"). See the README.
#
# Without a macro you only get the `Idle>` prompt and no viewer, i.e. the
# commands below have to be typed by hand.

# Open the default viewer. That is the Qt/OpenGL one for `--runType qt`. Set
# G4VIS_DEFAULT_DRIVER=TSG_OFFSCREEN to render into a PNG file instead, which
# also works with `--runType vis`.
/vis/open

# Collect all the changes below and only draw once, at the end
/vis/viewer/set/autoRefresh false
/vis/verbose errors

# Draw the geometry. The world volume is invisible, so the scene extent is
# given by the calorimeter and `zoomTo 1` fits it into the window.
/vis/drawVolume
/vis/viewer/set/style surface
/vis/viewer/set/auxiliaryEdge true
/vis/viewer/set/background white
/vis/viewer/set/viewpointThetaPhi 75 25
/vis/viewer/zoomTo 1

# Coordinate axes at the origin, i.e. at the front face of the solenoid that
# is not part of the translation yet. 10 cm long.
/vis/scene/add/axes 0 0 0 10 cm

# Accumulate the trajectories of all events of a run and colour them by charge
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByCharge
/vis/scene/endOfEventAction accumulate
/vis/scene/add/hits

/vis/viewer/set/autoRefresh true
/vis/viewer/flush
